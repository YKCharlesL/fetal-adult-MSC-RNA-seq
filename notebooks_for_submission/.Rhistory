mart <- useEnsembl(biomart = "ensembl", host = "https://e116.ensembl.org")
datasets <- listDatasets(mart)
# `mart` was used but never created in the original notebook - it only ran if
# a mart object happened to be left over from another session.
mart <- useEnsembl(biomart = "ensembl", host = "https://e116.ensembl.org")
mart <- useEnsembl(biomart = "ensembl", host = "https://e116.ensembl.org")
mart <- useEnsembl(biomart = "ensembl", host = "https://e116.ensembl.org")
# `mart` was used but never created in the original notebook - it only ran if
# a mart object happened to be left over from another session.
mart <- useEnsembl(biomart = "ensembl",
dataset = "hsapiens_gene_ensembl",
host = "https://may2024.archive.ensembl.org")
# Offline replacement for biomaRt: EnsDb.Hsapiens.v86 ships as a local
# SQLite database, so once installed this step needs no network access
# and is immune to Ensembl outages.
# BiocManager::install("EnsDb.Hsapiens.v86")  # run once if not installed
library(EnsDb.Hsapiens.v86)
# Offline replacement for biomaRt: EnsDb.Hsapiens.v86 ships as a local
# SQLite database, so once installed this step needs no network access
# and is immune to Ensembl outages.
BiocManager::install("EnsDb.Hsapiens.v86")  # run once if not installed
library(EnsDb.Hsapiens.v86)
edb <- EnsDb.Hsapiens.v86
# Pull gene_id + biotype for all genes in the annotation (offline, local query)
annot <- genes(edb, columns = c("gene_id", "gene_biotype"), return.type = "data.frame")
coding.counts <- lapply(counts_raw, function(cts){
pc <- annot$gene_id[annot$gene_biotype == "protein_coding"]
cts[rownames(cts) %in% pc, , drop = FALSE]
})
vapply(coding.counts, nrow, integer(1))   # protein-coding genes retained
